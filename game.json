{
  "name": "ZTCG",
  "deckBuilding": {
    "mainFilters": [ "type", "crystallize", "expand" ],
    "formats": [
      {
        "title": "Standard",
        "gameplay": "Standard",
        "customCategories": [
          "Emblem"
        ]
      }
    ]
  },

  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 5,
        "mulliganCount": {
          "max": 1
        },
        "mulliganCycle": {
          "info": "Put back as many cards as you want.",
          "steps": [
            "toBottom",
            "draw"
          ],
          "selectionRange": {
            "min": 0,
            "max": 5
          }
        }
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },
      "countersStartingValues": [ 20 ],

      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                { "section": "Emblem1" },
                { "section": "Emblem2" },
                { "section": "FrontRow1" },
                { "section": "FrontRow2" }
              ]
            },
            {
              "direction": "row",
              "content": [
                { "section": "BackRaw1" },
                { "section": "BackRaw2" },
                { "section": "BackRaw3" },
                { "section": "BackRaw4" }
              ]
            },
            { "section": "Cristals" }
          ]
        },
        "sectionsDict": {
          "Emblem1": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "EMBLEM",
            "enterTapped": true
          },
          "Emblem2": {
            "isHidden": "no",
